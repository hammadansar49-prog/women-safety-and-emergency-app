<?xml version="1.0" encoding="utf-8"?>
<!--
  The SafeHer mark for the adaptive launcher icon. The group scales the
  drawing's own 92 x 110 box to 62% of the 108dp viewport and centres it, so
  the shoulders survive the circular mask some launchers apply.
  The face is filled with the background colour rather than cut out, because
  the layer underneath is that same colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6087"
        android:scaleY="0.6087"
        android:translateX="17.48"
        android:translateY="14.43">
        <path
            android:fillColor="#FFF7F3"
            android:pathData="M60,80 C34,80 18,96 14,120 L106,120 C102,96 86,80 60,80 Z" />
        <path
            android:fillColor="#FFF7F3"
            android:pathData="M38,110 C28,62 34,10 60,10 C86,10 92,62 82,110 C78,96 72,90 68,86 L52,86 C48,90 42,96 38,110 Z" />
        <path
            android:fillColor="#C2255C"
            android:pathData="M79,50 A19,24 0 1,1 41,50 A19,24 0 1,1 79,50 Z" />
        <path
            android:fillColor="#FFF7F3"
            android:pathData="M60,10 C45,10 38,24 36,44 C43,36 52,32 60,32 C68,32 77,36 84,44 C82,24 75,10 60,10 Z" />
    </group>
</vector>
